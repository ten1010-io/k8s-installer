imports = ["/etc/containerd/config.d/*.toml"]
version = 4

[plugins]

  [plugins."io.containerd.cri.v1.images"]

    # The sandbox image, which containerd pulls itself for every pod rather than
    # being told about it by kubelet. Named here as a pinned image, which is where
    # containerd 2 moved what version 2 of this file called sandbox_image
    [plugins."io.containerd.cri.v1.images".pinned_images]
      sandbox = "{{ internal_network_ki_cp_dns_name }}:{{ ki_cp_k8s_registry_port }}/pause:{{ k8s_pause_version }}"

  [plugins."io.containerd.cri.v1.runtime"]
{%- if containerd_device_ownership_from_security_context | default(false) %}
    # Gives a device handed to a container the user and the group the container
    # runs as, rather than leaving it root's. A pod that is not root can open a
    # raw block volume only this way. Written only when it is on, so that a node
    # of a cluster that never turned it on holds the file it always held
    device_ownership_from_security_context = true
{%- endif %}

    [plugins."io.containerd.cri.v1.runtime".containerd]

      [plugins."io.containerd.cri.v1.runtime".containerd.runtimes]

        [plugins."io.containerd.cri.v1.runtime".containerd.runtimes.runc]
          runtime_type = "io.containerd.runc.v2"
          sandboxer = "podsandbox"

          [plugins."io.containerd.cri.v1.runtime".containerd.runtimes.runc.options]
            BinaryName = ""
            CriuImagePath = ""
            CriuPath = ""
            CriuWorkPath = ""
            IoGid = 0
            IoUid = 0
            NoNewKeyring = false
            NoPivotRoot = false
            Root = ""
            ShimCgroup = ""
            SystemdCgroup = true
