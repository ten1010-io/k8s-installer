apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
nodeRegistration:
  name: "{{ node_name }}"
  kubeletExtraArgs:
    - name: node-ip
      value: {{ internal_network_interfaces[0]['ip'] }}
{%- if k8s_node_taints %}
  # kubeadm taints a control plane node itself only while this field is unset, so
  # a node carrying a taint of its own has to carry that one too or it is
  # schedulable from the moment it comes up. The user does not write it:
  # validate-hostvars.py refuses the key, so there is one owner of it
  taints:
    - key: node-role.kubernetes.io/control-plane
      effect: NoSchedule
{%- for node_taint in k8s_node_taints %}
    - key: {{ node_taint.key }}
{%- if node_taint.value is defined and node_taint.value %}
      value: "{{ node_taint.value }}"
{%- endif %}
      effect: {{ node_taint.effect }}
{%- endfor %}
{%- endif %}
{%- if node_cgroup_version == "v1" %}
  # From 1.35 kubeadm will not go past preflight on a cgroup v1 node: the finding
  # is fatal and it names failCgroupV1, and setting that in the kubelet
  # configuration does not satisfy it. The two are opened together or neither
  # takes effect.
  #
  # What is named is the whole SystemVerification check rather than the one
  # finding, because that is the granularity kubeadm ignores at, so the kernel
  # release and the container runtime it also looks at stop being fatal on this
  # node too. Asked for only on a node that is actually on cgroup v1
  ignorePreflightErrors:
    - SystemVerification
{%- endif %}
localAPIEndpoint:
  advertiseAddress: {{ internal_network_interfaces[0]['ip'] }}
  bindPort: {{ k8s_apiserver_port }}
patches:
  directory: {{ ki_etc_kubeadm_path }}/patches
