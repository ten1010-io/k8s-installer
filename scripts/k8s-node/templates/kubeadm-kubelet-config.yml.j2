apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
# cgroupDriver is intentionally omitted. kubeadm fills it in from the detected
# container runtime, and setting it here risks contradicting the SystemdCgroup
# setting of containerd
#
# enforceNodeAllocatable is intentionally left at its default value ["pods"].
# Adding kube-reserved or system-reserved to it requires kubeReservedCgroup and
# systemReservedCgroup to point at cgroups that already exist, and kubelet fails
# to start when they do not. The reservations below are used for scheduler
# accounting only, which is what keeps the node from being over committed
#
# The cpu lines stay even on a node that also names its reserved cpus. kubelet
# says it is overwriting them with the count of the named set and carries on, and
# taking them out here would not reach the node anyway: a node reads the cluster
# baseline and merges its own patch onto it, and a merge does not remove a key
systemReserved:
  cpu: "{{ kubelet_reservations['system_reserved']['cpu'] }}"
  memory: "{{ kubelet_reservations['system_reserved']['memory'] }}"
  ephemeral-storage: "{{ kubelet_reservations['system_reserved']['ephemeral-storage'] }}"
  pid: "{{ kubelet_reservations['system_reserved']['pid'] }}"
kubeReserved:
  cpu: "{{ kubelet_reservations['kube_reserved']['cpu'] }}"
  memory: "{{ kubelet_reservations['kube_reserved']['memory'] }}"
  ephemeral-storage: "{{ kubelet_reservations['kube_reserved']['ephemeral-storage'] }}"
  pid: "{{ kubelet_reservations['kube_reserved']['pid'] }}"
evictionHard:
  memory.available: "{{ kubelet_reservations['eviction_hard']['memory.available'] }}"
  nodefs.available: "{{ kubelet_reservations['eviction_hard']['nodefs.available'] }}"
  imagefs.available: "{{ kubelet_reservations['eviction_hard']['imagefs.available'] }}"
  nodefs.inodesFree: "{{ kubelet_reservations['eviction_hard']['nodefs.inodesFree'] }}"
{%- if kubelet_reserved_system_cpus %}
reservedSystemCPUs: "{{ kubelet_reserved_system_cpus }}"
{%- endif %}
{%- if kubelet_max_pods %}
maxPods: {{ kubelet_max_pods }}
{%- endif %}
{%- if kubelet_cpu_manager_policy != "none" %}
cpuManagerPolicy: {{ kubelet_cpu_manager_policy }}
{%- if kubelet_cpu_manager_full_pcpus_only %}
cpuManagerPolicyOptions:
  full-pcpus-only: "true"
{%- endif %}
{%- endif %}
{%- if kubelet_topology_manager_policy != "none" %}
topologyManagerPolicy: {{ kubelet_topology_manager_policy }}
topologyManagerScope: {{ kubelet_topology_manager_scope }}
{%- endif %}
{%- if node_cgroup_version == "v1" %}
# kubelet of 1.35 and newer will not start on a cgroup v1 host on its own:
# failCgroupV1 defaults to true there and kubelet exits saying it is configured
# not to run on one. rhel 8 boots cgroup v1 and carries a 4.18 kernel, while
# kubeadm itself says the kernel it recommends for cgroup v2 is 5.10 or newer, so
# a node of the rhel 8 this release supports can not be moved to the other
# hierarchy and is let through here instead
#
# Per node, and never in the baseline. A node on cgroup v2 keeps the default and
# with it the protection, and a merge can not remove a key, so a baseline
# carrying this would open cgroup v1 on every node of the cluster for good.
# init-k8s-cluster.sh and upload-k8s-kubelet-config.sh render the baseline with
# this variable forced to v2 for that reason
failCgroupV1: false
{%- endif %}
