global
    maxconn 5000
    log stdout format raw local0

defaults
    log                     global
    option                  dontlognull
    timeout queue           20s
    timeout connect         5s
    # A watch on the apiserver is open for hours and mostly silent, and this is a
    # tcp proxy, so an idle timeout cuts it. client-go pings over http/2 every 30s,
    # which the old 35s cleared by five seconds
    timeout client          30m
    timeout server          30m
    # Kept at or below inter, so that a check against an apiserver that hangs
    # rather than refusing still fails within a bounded number of intervals
    timeout check           2s

frontend frontend
    mode tcp
    bind 0.0.0.0:{{ ki_cp_k8s_cp_lb_port }}
    default_backend backend
    option tcplog

backend backend
    mode tcp
    balance roundrobin
    option httpchk
    http-check connect ssl
    # /readyz rather than /healthz. An apiserver that is shutting down keeps
    # answering /healthz until it stops listening, while /readyz turns negative as
    # soon as the shutdown begins, which is the notice this needs to take a node
    # out before it stops serving
    http-check send meth GET uri /readyz
    http-check expect status 200
    # Six seconds to notice an apiserver that is gone, and sessions held against
    # one that has been marked down are cut rather than left to hang on it until
    # they time out
    default-server inter 2s fall 3 rise 2 on-marked-down shutdown-sessions

{% for ih in backend_server_ih_list -%}
{{"    "}}server {{ ih }} {{ internal_network_hosts[ih]["interfaces"][0]["ip"] }}:{{ k8s_apiserver_port }} check verify none
{% endfor %}
frontend stats
    mode http
    bind 0.0.0.0:{{ ki_cp_k8s_cp_lb_stats_port }}
    stats enable
    stats uri /
    stats refresh 10s
    stats auth admin:"$STATS_ADMIN_PW"
