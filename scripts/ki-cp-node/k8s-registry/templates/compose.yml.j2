services:
  registry:
    image: {{ ki_cp_k8s_registry_image }}
    ports:
      - "{{ ki_cp_k8s_registry_port }}:5000"
    volumes:
      - "{{ var_svc_root_path }}/registry:/var/lib/registry"
      - "{{ ki_etc_pki_path }}/ki-cp-tls.crt:/etc/registry/tls.crt"
      - "{{ ki_etc_pki_path }}/ki-cp-tls.key:/etc/registry/tls.key"
    environment:
      TZ: "Asia/Seoul"
      REGISTRY_STORAGE_MAINTENANCE: |-
        uploadpurging:
          enabled: false
        readonly:
          enabled: {{ readonly_enabled }}
      # What lets prune-k8s-registry.yml remove a manifest at all. Deleting is
      # refused outright without it, and the storage a deleted manifest held is
      # only reclaimed by the garbage collection that runs after
      REGISTRY_STORAGE_DELETE_ENABLED: "true"
      REGISTRY_HTTP_TLS_CERTIFICATE: "/etc/registry/tls.crt"
      REGISTRY_HTTP_TLS_KEY: "/etc/registry/tls.key"
    network_mode: bridge
    logging:
      driver: json-file
      options:
        max-size: "{{ ki_cp_service_log_max_size }}"
        max-file: "{{ ki_cp_service_log_max_file }}"
    restart: always
