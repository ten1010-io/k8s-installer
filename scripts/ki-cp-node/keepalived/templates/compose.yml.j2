services:
  keepalived:
    image: {{ ki_cp_keepalived_image }}
    command: [--copy-service]
    volumes:
      - /run/docker.sock:/run/docker.sock
      - ./keepalived.conf:/container/service/keepalived/assets/keepalived.conf
      - ./check_node.sh:/etc/keepalived/check_node.sh
    environment:
      TZ: Asia/Seoul
    cap_add:
      - NET_ADMIN
      - NET_BROADCAST
      - NET_RAW
    network_mode: host
    logging:
      driver: json-file
      options:
        max-size: "{{ ki_cp_service_log_max_size }}"
        max-file: "{{ ki_cp_service_log_max_file }}"
    restart: always
