vrrp_script check_node {
  script "/etc/keepalived/check_node.sh"
  interval 3
  # No weight on purpose. A tracked script that carries one only lowers the
  # priority of the node, and a lower priority is something a peer acts on by
  # preempting, which nopreempt below forbids: the two together left the vip on
  # a node whose load balancer was stopped for fifty seconds with every request
  # refused. Without a weight a failing script puts the instance into FAULT, the
  # node stops advertising at all, and the peer takes over because nobody is
  # holding the address rather than because it outranks the holder. That also
  # retires the question of whether the priorities are far enough apart
  #
  # Thirty seconds before the vip moves, which is slow for an outage and is
  # meant to be. Moving it kills every connection through it, on both nodes, and
  # the load balancer is restarted whenever the set of control plane nodes
  # changes. A shorter fall would turn each of those restarts into an outage
  fall 10
  rise 2
}

vrrp_instance VI_1 {
  # BACKUP on every node, including the one the priorities mean to win. That is
  # what nopreempt needs: keepalived ignores it on an instance that starts as
  # MASTER. With every node starting as BACKUP the highest priority one takes
  # the vip a few seconds after the first of them comes up, which is the same
  # node it would have been
  state BACKUP
  # A node that has just recovered does not take the vip back. Taking it back
  # kills every connection the node that is serving has, and there is nothing to
  # win by moving it: the node holding it is serving. Without this a load
  # balancer that came back moved the vip a second time fifteen seconds later,
  # so one failure cost two outages instead of one. The priorities still decide
  # who wins when nobody holds it
  nopreempt
  interface {{ interface }}
  unicast_src_ip {{ unicast_src_ip }}
  priority {{ priority }}
  unicast_peer {
{%- for peer in unicast_peers %}
    {{ peer }}
{%- endfor %}
  }
  virtual_router_id 51
  virtual_ipaddress {
    {{ ki_cp_ha_mode_vip }}
  }
  authentication {
    auth_type PASS
    auth_pass 42
  }
  track_script {
    check_node
  }
}
