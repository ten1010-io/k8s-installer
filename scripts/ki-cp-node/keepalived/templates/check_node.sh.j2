#!/bin/sh

msg() {
  echo >&2 "${1-}"
}

die() {
  msg=$1
  code=${2-1} # default exit status 1
  msg "$msg"
  exit "$code"
}

# What decides whether this node should keep the vip is whether it can serve the
# control plane, which is whether its load balancer is there and still has an
# apiserver to send work to. Pinging docker answered neither: the load balancer
# keeps running while the daemon is down, and a node whose apiservers are all
# gone answered that it was fine and held the vip over a control plane it could
# not reach.
#
# The load balancer answers both on one url. The connection is refused while it
# is gone, and 503 comes back while no backend of it is usable
curl --silent --fail --max-time 2 http://127.0.0.1:{{ ki_cp_k8s_cp_lb_stats_port }}/lb-healthz >/dev/null ||
  die "[ERROR] Health check for the apiserver load balancer failed"
